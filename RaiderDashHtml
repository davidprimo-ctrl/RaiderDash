<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MotoPlay</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

  :root {
    --bg:        #0d0d0f;
    --panel:     #141417;
    --card:      #1c1c21;
    --border:    #2a2a32;
    --accent:    #1db954;
    --accent2:   #ff6b35;
    --text:      #f0f0f5;
    --muted:     #8888a0;
    --spotify:   #1db954;
    --maps-blue: #4285f4;
  }

  html, body {
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: var(--bg);
    font-family: 'Inter', sans-serif;
    color: var(--text);
  }

  /* ── LAYOUT ── */
  #app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
  }

  /* Top status bar */
  #statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    min-height: 40px;
    flex-shrink: 0;
    z-index: 100;
  }
  #statusbar .logo {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
  }
  #statusbar .time {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }
  #statusbar .icons {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  #statusbar .icons svg {
    width: 16px; height: 16px;
    fill: var(--muted);
  }

  /* Main split */
  #main {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* ── LEFT: MAPS ── */
  #maps-panel {
    flex: 1.1;
    position: relative;
    background: #1a1a2e;
    overflow: hidden;
    border-right: 1px solid var(--border);
  }

  #maps-panel iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Map overlay controls */
  #map-overlay {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }
  .map-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
  }
  .map-btn:active { background: var(--card); }
  .map-btn svg { width:20px; height:20px; fill:var(--text); }

  #waze-btn {
    background: #1a73e8;
    border-color: #1a73e8;
    width: auto;
    padding: 0 14px;
    border-radius: 22px;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
  }

  /* Speed badge */
  #speed-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 6px 12px;
    z-index: 10;
    text-align: center;
  }
  #speed-badge .spd-num {
    font-family: 'Rajdhani', sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    color: var(--text);
  }
  #speed-badge .spd-unit {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 1px;
  }

  /* ── RIGHT: CONTROLS ── */
  #right-panel {
    width: 220px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    overflow: hidden;
  }

  /* Nav icons (right column) */
  #nav-icons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .nav-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--card);
    transition: background 0.15s, transform 0.1s;
    flex-shrink: 0;
  }
  .nav-icon.active { background: #26263a; }
  .nav-icon:active { transform: scale(0.93); }
  .nav-icon svg { width:24px; height:24px; }

  /* Screens */
  .screen { display:none; flex:1; flex-direction:column; overflow:hidden; }
  .screen.active { display:flex; }

  /* ── SPOTIFY SCREEN ── */
  #spotify-screen {
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px;
  }

  .music-icon-wrap {
    width: 70px;
    height: 70px;
    border-radius: 16px;
    background: linear-gradient(135deg, #6f3dff 0%, #b742e0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .music-icon-wrap svg { width:38px; height:38px; fill:#fff; }

  #spotify-screen h2 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    text-align: center;
  }
  #spotify-screen p {
    font-size: 11px;
    color: var(--muted);
    text-align: center;
  }
  #connect-spotify-btn {
    background: var(--spotify);
    color: #fff;
    border: none;
    border-radius: 22px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    transition: opacity 0.15s, transform 0.1s;
    letter-spacing: 0.3px;
  }
  #connect-spotify-btn:active { opacity:0.85; transform:scale(0.97); }

  /* Now playing */
  #now-playing {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px;
    flex: 1;
  }
  #album-art {
    width: 90px;
    height: 90px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ff6b35, #f7c948);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  #album-art img { width:100%; height:100%; object-fit:cover; border-radius:12px; display:none; }
  #album-art svg { width:42px; height:42px; fill:#fff; }

  .track-info { text-align:center; width:100%; }
  .track-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-artist { font-size: 11px; color: var(--muted); }

  /* Progress */
  .progress-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .progress-bar {
    width: 100%;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 35%;
    background: var(--spotify);
    border-radius: 2px;
    transition: width 1s linear;
  }
  .progress-times {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: var(--muted);
  }

  /* Music controls */
  .music-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 4px;
  }
  .ctrl-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border-radius: 50%;
    transition: background 0.15s, transform 0.1s;
  }
  .ctrl-btn:active { background: var(--card); transform: scale(0.9); }
  .ctrl-btn svg { width:20px; height:20px; fill:var(--muted); }
  .ctrl-btn.play-btn svg { width:28px; height:28px; fill:var(--text); }

  /* Volume */
  .vol-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
  }
  .vol-row svg { width:14px; height:14px; fill:var(--muted); flex-shrink:0; }
  .vol-slider {
    -webkit-appearance: none;
    flex: 1;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    outline: none;
  }
  .vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--text);
    cursor: pointer;
  }

  /* ── MAPS SCREEN ── */
  #maps-screen {
    padding: 10px;
    gap: 8px;
    justify-content: center;
  }
  #maps-screen p { font-size: 11px; color: var(--muted); text-align:center; }
  .dest-input {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 10px;
    color: var(--text);
    font-size: 12px;
    width: 100%;
    outline: none;
  }
  .dest-input::placeholder { color: var(--muted); }
  .nav-btn {
    background: var(--maps-blue);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 9px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    transition: opacity 0.15s;
  }
  .nav-btn:active { opacity: 0.8; }

  /* ── PHONE SCREEN ── */
  #phone-screen {
    padding: 10px;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }
  #phone-screen h3 { font-size:14px; font-weight:600; color:var(--text); }
  .dial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: 100%;
  }
  .dial-key {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 4px;
    text-align: center;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    transition: background 0.12s, transform 0.1s;
  }
  .dial-key:active { background: var(--border); transform: scale(0.94); }
  .dial-key sub { display:block; font-size:7px; font-weight:400; color:var(--muted); }
  #dial-display {
    font-family: 'Rajdhani', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 2px;
    min-height: 30px;
  }
  .call-btn {
    background: #27ae60;
    border: none;
    border-radius: 50%;
    width: 46px; height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .call-btn svg { width:22px; height:22px; fill:#fff; }

  /* ── SETTINGS SCREEN ── */
  #settings-screen {
    padding: 10px;
    gap: 6px;
    overflow-y: auto;
  }
  #settings-screen h3 { font-size:13px; font-weight:600; color:var(--text); margin-bottom:4px; }
  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--card);
    border-radius: 10px;
    padding: 9px 10px;
  }
  .setting-row span { font-size:11px; color:var(--muted); }
  .toggle {
    width: 36px; height: 20px;
    background: var(--border);
    border-radius: 10px;
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
  }
  .toggle.on { background: var(--accent); }
  .toggle::after {
    content:'';
    position:absolute;
    width:16px; height:16px;
    border-radius:50%;
    background: #fff;
    top:2px; left:2px;
    transition: transform 0.2s;
  }
  .toggle.on::after { transform: translateX(16px); }

  /* Bottom bar */
  #bottombar {
    display: flex;
    border-top: 1px solid var(--border);
    background: var(--bg);
    flex-shrink: 0;
    min-height: 48px;
  }
  .bottom-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
    padding: 6px;
    transition: background 0.15s;
    border: none;
    background: none;
    color: var(--muted);
  }
  .bottom-btn.active { color: var(--accent); }
  .bottom-btn:active { background: var(--card); }
  .bottom-btn svg { width:20px; height:20px; fill:currentColor; }
  .bottom-btn span { font-size:9px; font-weight:500; }

  /* Auth overlay */
  #auth-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 999;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
  }
  #auth-overlay.visible { display: flex; }
  .auth-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px 24px;
    max-width: 320px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .auth-title { font-family:'Rajdhani',sans-serif; font-size:22px; font-weight:700; color:var(--text); }
  .auth-sub { font-size:12px; color:var(--muted); }
  .auth-spotify-btn {
    background: var(--spotify);
    color: #fff;
    border: none;
    border-radius: 25px;
    padding: 12px 28px;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    width:100%;
    letter-spacing:0.5px;
    transition: opacity 0.15s;
  }
  .auth-spotify-btn:active { opacity:0.85; }
  .auth-cancel {
    font-size:12px;
    color:var(--muted);
    cursor:pointer;
    text-decoration:underline;
  }
  #auth-status { font-size:11px; color:var(--muted); }
</style>
</head>
<body>

<div id="app">

  <!-- Status bar -->
  <div id="statusbar">
    <div class="logo">MOTOPLAY</div>
    <div class="time" id="clock">--:--</div>
    <div class="icons">
      <!-- Battery -->
      <svg viewBox="0 0 24 24"><rect x="2" y="7" width="18" height="10" rx="2" fill="none" stroke="#8888a0" stroke-width="1.5"/><path d="M20 10v4" stroke="#8888a0" stroke-width="1.5" stroke-linecap="round"/><rect x="3.5" y="8.5" width="12" height="7" rx="1" fill="#8888a0"/></svg>
      <!-- Signal -->
      <svg viewBox="0 0 24 24"><rect x="2" y="16" width="3" height="5" rx="1" fill="#8888a0"/><rect x="7" y="12" width="3" height="9" rx="1" fill="#8888a0"/><rect x="12" y="8" width="3" height="13" rx="1" fill="#8888a0"/><rect x="17" y="4" width="3" height="17" rx="1" fill="#8888a0"/></svg>
    </div>
  </div>

  <!-- Main split -->
  <div id="main">

    <!-- LEFT: Google Maps -->
    <div id="maps-panel">
      <div id="speed-badge">
        <div class="spd-num" id="speed">0</div>
        <div class="spd-unit">KM/H</div>
      </div>
      <iframe
        id="maps-iframe"
        src="https://www.google.com/maps/embed?pb=!1m0&output=embed&ll=4.438889,-75.232222&z=15"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen>
      </iframe>
      <div id="map-overlay">
        <div class="map-btn" onclick="centerMap()" title="Mi ubicación">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="#f0f0f5" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
        </div>
        <div class="map-btn waze-style" id="waze-btn" onclick="openWaze()" style="background:#1a73e8;border-color:#1a73e8;width:auto;padding:0 14px;border-radius:22px;gap:6px;font-size:12px;font-weight:600;color:#fff;display:flex;align-items:center;">
          <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:#fff;flex-shrink:0;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
          Waze
        </div>
      </div>
    </div>

    <!-- RIGHT: Control panel -->
    <div id="right-panel">

      <!-- Spotify / Música -->
      <div class="screen active" id="spotify-screen">
        <div class="music-icon-wrap">
          <svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg>
        </div>
        <h2>Conectar Spotify</h2>
        <p>Toca el botón para autorizar</p>
        <button id="connect-spotify-btn" onclick="connectSpotify()">Conectar con Spotify</button>
        <p style="font-size:10px;">Redirigiendo a Spotify...</p>
      </div>

      <!-- Now playing (hidden until connected) -->
      <div id="now-playing">
        <div id="album-art">
          <img id="album-img" alt="Album Art">
          <svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg>
        </div>
        <div class="track-info">
          <div class="track-name" id="track-name">Sin reproducción</div>
          <div class="track-artist" id="track-artist">—</div>
        </div>
        <div class="progress-wrap">
          <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
          <div class="progress-times"><span id="t-cur">0:00</span><span id="t-tot">3:30</span></div>
        </div>
        <div class="music-controls">
          <button class="ctrl-btn" onclick="prevTrack()">
            <svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
          </button>
          <button class="ctrl-btn play-btn" id="play-btn" onclick="togglePlay()">
            <svg viewBox="0 0 24 24" id="play-icon"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button class="ctrl-btn" onclick="nextTrack()">
            <svg viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zm2-8.14 5.5 2.14-5.5 2.14V9.86zM16 6h2v12h-2z"/></svg>
          </button>
        </div>
        <div class="vol-row">
          <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
          <input type="range" class="vol-slider" min="0" max="100" value="70" id="volume" oninput="setVolume(this.value)">
          <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM18.5 12c0-2.77-1.5-5.16-3.8-6.4v12.8c2.3-1.23 3.8-3.63 3.8-6.4z"/></svg>
        </div>
      </div>

      <!-- Maps search screen -->
      <div class="screen" id="maps-screen">
        <p style="font-weight:600;font-size:13px;color:var(--text);">Navegar a...</p>
        <input class="dest-input" id="destination" placeholder="Destino..." type="text">
        <button class="nav-btn" onclick="startNav()">🗺 Iniciar ruta</button>
        <button class="nav-btn" onclick="openGoogleMaps()" style="background:#1a73e8;">
          ↗ Abrir Google Maps
        </button>
      </div>

      <!-- Phone screen -->
      <div class="screen" id="phone-screen">
        <h3>Marcar</h3>
        <div id="dial-display">_</div>
        <div class="dial-grid">
          <div class="dial-key" onclick="dial('1')">1<sub>&#8203;</sub></div>
          <div class="dial-key" onclick="dial('2')">2<sub>ABC</sub></div>
          <div class="dial-key" onclick="dial('3')">3<sub>DEF</sub></div>
          <div class="dial-key" onclick="dial('4')">4<sub>GHI</sub></div>
          <div class="dial-key" onclick="dial('5')">5<sub>JKL</sub></div>
          <div class="dial-key" onclick="dial('6')">6<sub>MNO</sub></div>
          <div class="dial-key" onclick="dial('7')">7<sub>PQRS</sub></div>
          <div class="dial-key" onclick="dial('8')">8<sub>TUV</sub></div>
          <div class="dial-key" onclick="dial('9')">9<sub>WXYZ</sub></div>
          <div class="dial-key" onclick="dial('*')">*</div>
          <div class="dial-key" onclick="dial('0')">0<sub>+</sub></div>
          <div class="dial-key" onclick="dialDel()">⌫</div>
        </div>
        <div style="display:flex;gap:12px;width:100%;justify-content:center;margin-top:4px;">
          <button class="call-btn" onclick="makeCall()">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
          </button>
        </div>
      </div>

      <!-- Settings screen -->
      <div class="screen" id="settings-screen">
        <h3>Ajustes</h3>
        <div class="setting-row">
          <span>Pantalla completa</span>
          <div class="toggle on" onclick="this.classList.toggle('on')" id="t-fullscreen"></div>
        </div>
        <div class="setting-row">
          <span>Modo noche</span>
          <div class="toggle on" onclick="this.classList.toggle('on')"></div>
        </div>
        <div class="setting-row">
          <span>GPS activo</span>
          <div class="toggle on" onclick="this.classList.toggle('on')"></div>
        </div>
        <div class="setting-row">
          <span>Bluetooth</span>
          <div class="toggle" onclick="this.classList.toggle('on')"></div>
        </div>
        <div class="setting-row">
          <span>Alertas velocidad</span>
          <div class="toggle on" onclick="this.classList.toggle('on')"></div>
        </div>
        <div style="margin-top:8px;">
          <p style="font-size:10px;color:var(--muted);text-align:center;">MotoPlay v1.0 · Para App Inventor WebViewer</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom nav -->
  <div id="bottombar">
    <button class="bottom-btn active" onclick="switchScreen('spotify','this')" id="btn-spotify">
      <svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg>
      <span>Música</span>
    </button>
    <button class="bottom-btn" onclick="switchScreen('maps','this')" id="btn-maps">
      <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      <span>Mapa</span>
    </button>
    <button class="bottom-btn" onclick="switchScreen('phone','this')" id="btn-phone">
      <svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
      <span>Teléfono</span>
    </button>
    <button class="bottom-btn" onclick="switchScreen('settings','this')" id="btn-settings">
      <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
      <span>Ajustes</span>
