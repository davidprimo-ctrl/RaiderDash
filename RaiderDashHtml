</div>

<!-- Spotify Auth Overlay -->
<div id="auth-overlay">
  <div class="auth-card">
    <div class="music-icon-wrap" style="width:64px;height:64px;border-radius:50%;">
      <svg viewBox="0 0 24 24" style="width:32px;height:32px;fill:#1db954;"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
    </div>
    <div class="auth-title">Conectar Spotify</div>
    <div class="auth-sub">Para reproducir música necesitas autorizar tu cuenta de Spotify</div>
    <button class="auth-spotify-btn" onclick="doSpotifyAuth()">Conectar con Spotify</button>
    <div id="auth-status"></div>
    <span class="auth-cancel" onclick="closeAuth()">Cancelar</span>
  </div>
</div>

<script>
// ── CLOCK ──
function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0');
  const m = String(now.getMinutes()).padStart(2,'0');
  document.getElementById('clock').textContent = h + ':' + m;
}
updateClock();
setInterval(updateClock, 10000);

// ── SCREEN SWITCHING ──
const screens = ['spotify','maps','phone','settings'];
const SPOTIFY_CLIENT_ID = 'TU_CLIENT_ID_AQUI'; // <-- cambiar
const REDIRECT_URI = 'https://TU_PAGINA.github.io/callback.html'; // <-- cambiar

function switchScreen(name) {
  screens.forEach(s => {
    const el = document.getElementById(s + '-screen');
    if (el) el.classList.toggle('active', s === name);
    const btn = document.getElementById('btn-' + s);
    if (btn) btn.classList.toggle('active', s === name);
  });
}

// ── SPOTIFY ──
function connectSpotify() {
  document.getElementById('auth-overlay').classList.add('visible');
}
function closeAuth() {
  document.getElementById('auth-overlay').classList.remove('visible');
}
function doSpotifyAuth() {
  document.getElementById('auth-status').textContent = 'Redirigiendo a Spotify...';
  const scopes = 'user-read-playback-state user-modify-playback-state user-read-currently-playing';
  const url = `https://accounts.spotify.com/authorize?client_id=${SPOTIFY_CLIENT_ID}&response_type=token&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&scope=${encodeURIComponent(scopes)}`;
  window.location.href = url;
}

// Check for token in URL hash (after redirect)
function checkSpotifyToken() {
  const hash = window.location.hash;
  if (hash) {
    const params = new URLSearchParams(hash.substring(1));
    const token = params.get('access_token');
    if (token) {
      localStorage.setItem('spotify_token', token);
      window.location.hash = '';
      loadSpotifyPlayer(token);
    }
  }
  const saved = localStorage.getItem('spotify_token');
  if (saved) loadSpotifyPlayer(saved);
}

function loadSpotifyPlayer(token) {
  document.getElementById('spotify-screen').style.display = 'none';
  document.getElementById('now-playing').style.display = 'flex';
  fetchCurrentTrack(token);
}

async function fetchCurrentTrack(token) {
  try {
    const r = await fetch('https://api.spotify.com/v1/me/player/currently-playing', {
      headers: { 'Authorization': 'Bearer ' + token }
    });
    if (r.status === 200) {
      const data = await r.json();
      if (data && data.item) {
        document.getElementById('track-name').textContent = data.item.name;
        document.getElementById('track-artist').textContent = data.item.artists.map(a=>a.name).join(', ');
        const img = data.item.album.images[0]?.url;
        if (img) {
          const imgEl = document.getElementById('album-img');
          imgEl.src = img;
          imgEl.style.display = 'block';
          document.getElementById('album-art').querySelector('svg').style.display = 'none';
        }
        const pct = (data.progress_ms / data.item.duration_ms) * 100;
        document.getElementById('progress-fill').style.width = pct + '%';
        const fmt = ms => {
          const s = Math.floor(ms/1000);
          return Math.floor(s/60) + ':' + String(s%60).padStart(2,'0');
        };
        document.getElementById('t-cur').textContent = fmt(data.progress_ms);
        document.getElementById('t-tot').textContent = fmt(data.item.duration_ms);
      }
    }
  } catch(e) { console.log('Spotify error', e); }
}

// Music controls
let isPlaying = false;
function togglePlay() {
  isPlaying = !isPlaying;
  const icon = document.getElementById('play-icon');
  icon.innerHTML = isPlaying
    ? '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>'
    : '<path d="M8 5v14l11-7z"/>';
  const token = localStorage.getItem('spotify_token');
  if (token) {
    fetch('https://api.spotify.com/v1/me/player/' + (isPlaying ? 'pause' : 'play'), {
      method: 'PUT', headers: { 'Authorization': 'Bearer ' + token }
    });
  }
}
function nextTrack() {
  const token = localStorage.getItem('spotify_token');
  if (token) fetch('https://api.spotify.com/v1/me/player/next', {
    method: 'POST', headers: { 'Authorization': 'Bearer ' + token }
  });
}
function prevTrack() {
  const token = localStorage.getItem('spotify_token');
  if (token) fetch('https://api.spotify.com/v1/me/player/previous', {
    method: 'POST', headers: { 'Authorization': 'Bearer ' + token }
  });
}
function setVolume(val) {
  const token = localStorage.getItem('spotify_token');
  if (token) fetch(`https://api.spotify.com/v1/me/player/volume?volume_percent=${val}`, {
    method: 'PUT', headers: { 'Authorization': 'Bearer ' + token }
  });
}

// ── MAPS ──
function centerMap() {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
      const lat = pos.coords.latitude;
      const lng = pos.coords.longitude;
      document.getElementById('maps-iframe').src =
        `https://www.google.com/maps/embed?pb=!1m0&output=embed&ll=${lat},${lng}&z=16`;
    });
  }
}
function startNav() {
  const dest = document.getElementById('destination').value;
  if (!dest) return;
  openGoogleMaps(dest);
}
function openGoogleMaps(dest) {
  const q = dest ? encodeURIComponent(dest) : '';
  window.open('https://www.google.com/maps/dir/?api=1&destination=' + q, '_blank');
}
function openWaze() {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
      window.open(`https://waze.com/ul?ll=${pos.coords.latitude},${pos.coords.longitude}&navigate=yes`, '_blank');
    });
  } else {
    window.open('https://waze.com', '_blank');
  }
}

// ── GPS SPEED ──
let speedTimer;
function startGPS() {
  if (navigator.geolocation) {
    navigator.geolocation.watchPosition(pos => {
      const spd = pos.coords.speed;
      document.getElementById('speed').textContent = spd ? Math.round(spd * 3.6) : '0';
    }, null, { enableHighAccuracy: true });
  }
}
startGPS();

// ── DIAL ──
let dialNum = '';
function dial(k) {
  dialNum += k;
  document.getElementById('dial-display').textContent = dialNum || '_';
}
function dialDel() {
  dialNum = dialNum.slice(0,-1);
  document.getElementById('dial-display').textContent = dialNum || '_';
}
function makeCall() {
  if (dialNum) window.location.href = 'tel:' + dialNum;
}

// ── INIT ──
checkSpotifyToken();
</script>
</body>
</html>
